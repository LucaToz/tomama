# Admin — password per /admin-portal (obbligatoria in produzione)
ADMIN_PASSWORD=your-strong-admin-password

# Sessione vault — stringa casuale lunga per firmare i cookie (obbligatoria in produzione)
# Genera con: openssl rand -base64 32
VAULT_SESSION_SECRET=your-random-secret-here

# Vercel Blob — creato automaticamente collegando lo store al progetto
BLOB_READ_WRITE_TOKEN=

# URL pubblico del sito (Open Graph, share)
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
